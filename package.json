{
  "name": "boardenda",
  "productName": "Boardenda",
  "version": "0.1.1",
  "description": "Local-first work management for Windows: boards, groups and items with typed columns, table, kanban, timeline, calendar, chart, workload and form views, automations, dashboards and reminders.",
  "author": "Boardenda",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:ui": "node scripts/build-ui.js",
    "start": "npm run build:ui && electron .",
    "dev:web": "npm run build:ui && node dev/server.js",
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "npm run build:ui && node test/ui/smoke.js",
    "icons": "python3 scripts/make-icons.py",
    "dist": "npm run build:ui && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "exceljs": "^4.4.0",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "preact": "^10.29.8"
  },
  "build": {
    "appId": "com.boardenda.app",
    "productName": "Boardenda",
    "copyright": "Copyright © 2026",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**", "src/core/**", "dist/ui/**", "package.json", "!**/*.map"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Boardenda",
      "artifactName": "Boardenda-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "Boardenda-Portable-${version}.${ext}" },
    "publish": [{ "provider": "github", "owner": "RecursiveMinded", "repo": "ProjectManagementapp", "releaseType": "release" }],
    "compression": "maximum"
  }
}
